  "productName": "OpenBMS Monitor",
  "version": "0.3.9-beta",
  "identifier": "io.github.privatecoder.openbms-monitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "OpenBMS Monitor", "width": 1280, "height": 820, "minWidth": 900, "minHeight": 600, "backgroundThrottling": "disabled" }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "perMachine" } },
    "macOS": { "signingIdentity": "-" },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": { "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5OEUyNkRGODU3NEMwRTUKUldUbHdIU0YzeWFPK1pud0k4YW5LQnlTMU5SSktxSnpXMU90bHJPeGJwRVNuWU5zUEhvcDJIVmwK", "endpoints": [], "windows": { "installMode": "passive" } }
  }
}
